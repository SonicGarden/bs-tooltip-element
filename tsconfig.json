{
	"compilerOptions": {
		"module": "esnext",
		"target": "es2017",
		"lib": ["es2018", "dom"],
		"strict": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "./types",
		"rootDir": "./src",
		"removeComments": true,
		"preserveConstEnums": true,
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true
	},
	"include": ["src/**/*.ts"]
}
